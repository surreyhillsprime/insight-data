{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight.local/schemas/inspire-parcels.schema.json",
  "title": "INSIGHT public HMLR INSPIRE parcel feed",
  "type": "object",
  "required": [
    "schemaVersion",
    "releaseId",
    "generatedAt",
    "canonicalIdentityMode",
    "associationSemantics",
    "associationTransitions",
    "source",
    "coverage",
    "associationsByProperty",
    "parcelsById"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "releaseId": {"type": "string", "pattern": "^inspire-parcels-"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "canonicalIdentityMode": {"const": "full-normalised-address-plus-postcode-fail-closed"},
    "associationSemantics": {"const": "indicative parcel association; not title, exact UPRN, ownership or legal-boundary confirmation"},
    "associationTransitions": {
      "type": "array",
      "items": {"$ref": "#/$defs/associationTransition"}
    },
    "source": {"type": "object"},
    "coverage": {"type": "object"},
    "associationsByProperty": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/publicAssociation"}
    },
    "parcelsById": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/parcel"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "associationTransition": {
      "type": "object",
      "required": ["transitionId", "propertyId", "previousParcelId", "priorAssociationReleaseId", "priorSourceSnapshot", "action", "replacementParcelId", "reviewedAt", "reviewedBy", "reason"],
      "properties": {
        "transitionId": {"type": "string", "pattern": "^inspire-transition-[a-z0-9_-]+$"},
        "propertyId": {"type": "string", "pattern": "^property:.+\\|[A-Z0-9]+$"},
        "previousParcelId": {"type": "string", "pattern": "^\\d+$"},
        "priorAssociationReleaseId": {"type": "string", "pattern": "^inspire-parcels-\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{12}$"},
        "priorSourceSnapshot": {"type": "string", "pattern": "^hmlr-inspire-\\d{4}-\\d{2}-\\d{2}$"},
        "action": {"enum": ["replace", "remove"]},
        "replacementParcelId": {"type": ["string", "null"], "pattern": "^\\d+$"},
        "reviewedAt": {"type": "string", "format": "date-time"},
        "reviewedBy": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"action": {"const": "replace"}}}, "then": {"properties": {"replacementParcelId": {"type": "string", "pattern": "^\\d+$"}}}},
        {"if": {"properties": {"action": {"const": "remove"}}}, "then": {"properties": {"replacementParcelId": {"const": null}}}}
      ],
      "additionalProperties": false
    },
    "publicAssociation": {
      "type": "object",
      "required": [
        "associationStatus",
        "primaryParcelId",
        "parcelIds",
        "matchMethod",
        "evidenceTier",
        "spatialClassification",
        "boundaryDistanceMetres",
        "reviewDecision",
        "sourceSnapshot",
        "titleConfirmed",
        "exactUprnIdentityConfirmed",
        "legalBoundaryConfirmed"
      ],
      "properties": {
        "associationStatus": {"enum": ["automatic_indicative", "reviewed_indicative"]},
        "primaryParcelId": {"type": "string", "pattern": "^\\d+$"},
        "parcelIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\d+$"}
        },
        "matchMethod": {"type": "string", "minLength": 1},
        "evidenceTier": {"enum": ["transaction_linked_indicative", "calibrated_epc_indicative", "reviewed_indicative", "authoritative_uprn_indicative"]},
        "spatialClassification": {"enum": ["unique_interior_clear", "unique_interior_edge"]},
        "boundaryDistanceMetres": {"type": ["number", "null"], "minimum": 0},
        "reviewDecision": {"type": ["object", "null"]},
        "sourceSnapshot": {"type": "string", "pattern": "^hmlr-inspire-"},
        "titleConfirmed": {"const": false},
        "exactUprnIdentityConfirmed": {"const": false},
        "legalBoundaryConfirmed": {"const": false}
      },
      "additionalProperties": false
    },
    "parcel": {
      "type": "object",
      "required": [
        "inspireId",
        "validFrom",
        "beginLifespanVersion",
        "authorities",
        "areaSquareMetres",
        "areaSquareFeet",
        "areaAcres",
        "areaBasis",
        "isExactLegalExtent",
        "centroid",
        "bbox",
        "geometry"
      ],
      "properties": {
        "inspireId": {"type": "string", "pattern": "^\\d+$"},
        "validFrom": {"type": "string", "minLength": 1},
        "beginLifespanVersion": {"type": "string", "minLength": 1},
        "authorities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "areaSquareMetres": {"type": "number", "exclusiveMinimum": 0},
        "areaSquareFeet": {"type": "integer", "minimum": 1},
        "areaAcres": {"type": "number", "exclusiveMinimum": 0},
        "areaBasis": {"const": "planar area of the HMLR INSPIRE index polygon in EPSG:27700"},
        "isExactLegalExtent": {"const": false},
        "centroid": {"$ref": "#/$defs/position"},
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number"}
        },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": {"const": "Polygon"},
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {"$ref": "#/$defs/position"}
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "number", "minimum": -180, "maximum": 180},
        {"type": "number", "minimum": -90, "maximum": 90}
      ],
      "items": false
    }
  }
}
